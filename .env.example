# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invest_wealth

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invest_wealth

# Server
PORT=3000

# JWT (gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace-with-64-random-chars

# SMTP (Gmail) — App Password de 16 chars, sem espaços
# Gerar em https://myaccount.google.com/apppasswords (requer verificação em 2 etapas)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password-16-chars-sem-espacos
MAIL_FROM="InvestWealth <seu-email@gmail.com>"
# Em dev, definir true para logar o código no console em vez de enviar
MAIL_LOG_ONLY=false

# Web Push (VAPID keys — geradas com `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@investwealth.app
